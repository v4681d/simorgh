# Reproducible Linux build environment for Simorgh (Tauri v2 + Rust stable).
# Usage:
#   docker build -f docker/Dockerfile.build -t simorgh-build .
#   docker run --rm -v $PWD:/src -w /src simorgh-build \
#     bash -c "pnpm install --dir ui && cargo tauri build"
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl wget ca-certificates git pkg-config \
    libwebkit2gtk-4.1-dev libgtk-3-dev libasound2-dev \
    libayatana-appindicator3-dev librsvg2-dev libssl-dev patchelf \
    file xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Rust stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
RUN cargo install tauri-cli --version '^2' --locked

# Node + pnpm for the UI
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm@9

WORKDIR /src
CMD ["bash"]
